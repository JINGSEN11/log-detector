# ============================================================================
# csys-template 环境变量样例
# 用法：cp .env.example .env  然后按需修改（.env 已在 .gitignore 中，禁止提交）
# 下列账号、密码和密钥是公开的本地演示值，仅用于隔离的开发环境。
# 请在 .env 中替换为自己的强密码和随机密钥，任何真实密钥都不得写进本文件。
# ============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_DATABASE=log_detector
# Docker 主机端口；后端容器内部仍通过 mysql:3306 连接
MYSQL_HOST_PORT=3306
MYSQL_USER=csys
MYSQL_PASSWORD=replace-with-local-db-password

# ---------- 后端数据源 ----------
# Compose 使用 DOCKER_DB_URL，默认通过 mysql 服务名连接；本机进程可另设 DB_URL
DOCKER_DB_URL=jdbc:mysql://mysql:3306/log_detector?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=csys
DB_PASSWORD=replace-with-local-db-password

# ---------- 鉴权 ----------
# 至少 32 字节的随机字符串，演示用；上线前必须替换
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_TTL_MINUTES=120
# 首次启动时自动创建的管理员密码（用户名固定 admin）
APP_ADMIN_PASSWORD=admin123
LOG_IP_HMAC_KEY=replace-with-a-random-secret-at-least-32-bytes-long

# ---------- 大模型 ----------
# LLM_MOCK=true：使用 MockLlmClient（固定样例，仅用于断网调试）
# LLM_MOCK=false：使用 OpenAI 兼容协议真实调用
# 注意：只能写小写 true / false（条件装配按字面值匹配）
LLM_MOCK=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# ---------- 其他 ----------
TZ=Asia/Shanghai
